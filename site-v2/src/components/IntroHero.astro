---
/* ============================================================
   IntroHero — full-viewport welcome that morphs into the
   sticky-sidebar layout on the user's first scroll input.

   Mechanism:
   - On load, render a fixed overlay (centred photo + name +
     tagline + cue) plus a 100vh spacer above the main layout
     so the page IS scrollable while the intro is up.
   - An inline script, on DOMContentLoaded, measures the
     resting position of the SiteHeader's photo/name targets
     while transiently hiding the spacer (so the rects reflect
     the post-teardown layout the user will land in).
   - On the FIRST scroll-down input (scroll, wheel, key,
     touchmove), a JS rAF animates `--intro-progress` from 0
     to 1 over 700ms with an ease-out curve. CSS `calc()`
     interpolates the FLIP photo + name transforms off that
     variable; tagline and cue fade out fast.
   - On animation completion the overlay and spacer are
     removed and scroll is reset to 0 — the SiteHeader is now
     the top of the page and scrolling back up stops there.

   Skip paths: deep-link load (`location.hash`),
   `prefers-reduced-motion: reduce`, or scroll-restored reload
   (`scrollY > 0`) — the overlay/spacer are removed before any
   animation runs.
   ============================================================ */
interface Props {
  name: string;
  tagline: string;
  profileSrc: string;
}

const { name, tagline, profileSrc } = Astro.props;

const taglineHtml = tagline
  .split(/\s+/)
  .filter(Boolean)
  .map((word, i) => `<span class="word" style="--i:${i}">${word}</span>`)
  .join(" ");
---

{/* FOUC-safe pre-paint skip detection. Sets a flag on <html>
    before first paint when we know the intro should not run. */}
<script is:inline>
  (function () {
    try {
      var hasHash = !!window.location.hash;
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (hasHash || reduced) {
        document.documentElement.setAttribute("data-intro-skip", "true");
      } else {
        document.documentElement.setAttribute("data-intro-active", "true");
      }
    } catch (e) {
      document.documentElement.setAttribute("data-intro-skip", "true");
    }
  })();
</script>

<div id="intro-spacer" data-intro-spacer aria-hidden="true"></div>

<div id="intro-overlay" data-intro-overlay aria-hidden="true">
  <div class="intro-stack">
    <img class="intro-photo intro-fade-in serif-display" src={profileSrc} alt="" width="96" height="96" />
    <h1 class="intro-name intro-fade-in serif-display" style="--i: 1">{name}</h1>
    <p
      class="intro-tagline intro-fade-in"
      style="--i: 3"
      set:html={taglineHtml}
    />
    <div class="intro-cue intro-fade-in" style="--i: 4" aria-hidden="true">
      <span class="intro-cue-label">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 4V20M12 20L6 14M12 20L18 14" />
      </svg>
    </div>
  </div>
</div>

<script is:inline>
  function __introInit() {
    var html = document.documentElement;
    var overlay = document.getElementById("intro-overlay");
    var spacer = document.getElementById("intro-spacer");
    if (!overlay || !spacer) return;

    // Teardown is a two-phase cross-fade so nothing pops:
    //   Phase 1 (`data-intro-fading`): spacer is removed and
    //   scroll reset, sidebar fades 0 → 1, overlay fades 1 → 0,
    //   sections in the right column reveal via their existing
    //   IntersectionObserver. The FLIP photo + name are still
    //   visible at their target positions, so the sidebar's
    //   actual photo + name cross-fade underneath without any
    //   misalignment.
    //   Phase 2 (~520 ms later): overlay removed from the DOM.
    var FADE_MS = 500;
    function teardown() {
      // Spacer goes first so the SiteHeader is at the top before
      // the cross-fade begins. scrollTo guards against any drift
      // from accumulated wheel deltas during the FLIP.
      if (spacer && spacer.parentNode) spacer.parentNode.removeChild(spacer);
      window.scrollTo(0, 0);
      html.style.setProperty("--intro-progress", "1");
      html.removeAttribute("data-intro-active");
      html.setAttribute("data-intro-fading", "true");
      // Skip path: if reduced motion or the overlay was already
      // gone before we ever animated, do an instant cleanup.
      if (!overlay || !overlay.parentNode) {
        html.removeAttribute("data-intro-fading");
        return;
      }
      window.setTimeout(function () {
        html.removeAttribute("data-intro-fading");
        if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay);
      }, FADE_MS + 20);
    }

    if (html.getAttribute("data-intro-skip") === "true") {
      teardown();
      return;
    }

    // Scroll-restored reload — bypass intro instantly.
    if (window.scrollY > 0) {
      teardown();
      return;
    }

    var introPhoto = overlay.querySelector(".intro-photo");
    var introName = overlay.querySelector(".intro-name");
    var targetPhoto = document.querySelector(".js-intro-target-photo");
    var targetName = document.querySelector(".js-intro-target-name");
    if (!introPhoto || !introName || !targetPhoto || !targetName) {
      teardown();
      return;
    }

    function measure() {
      // Targets reflect the layout the user will see AFTER teardown
      // (no spacer, scroll at 0). We hide the spacer transiently to
      // measure that geometry without triggering paint — the browser
      // computes layout synchronously inside getBoundingClientRect.
      var prevDisplay = spacer.style.display;
      spacer.style.display = "none";
      var pt = targetPhoto.getBoundingClientRect();
      var nt = targetName.getBoundingClientRect();
      spacer.style.display = prevDisplay;

      // Photo: FLIP delta is target-centre minus current overlay-centre.
      var ip = introPhoto.getBoundingClientRect();
      var ipCenter = { x: ip.left + ip.width / 2, y: ip.top + ip.height / 2 };
      var ptCenter = { x: pt.left + pt.width / 2, y: pt.top + pt.height / 2 };
      var photoScale = pt.width / ip.width;
      introPhoto.style.setProperty("--target-x", (ptCenter.x - ipCenter.x) + "px");
      introPhoto.style.setProperty("--target-y", (ptCenter.y - ipCenter.y) + "px");
      introPhoto.style.setProperty("--target-scale", String(photoScale));

      // Name: scale by height ratio so visual weight matches; align centres.
      var ina = introName.getBoundingClientRect();
      var inaCenter = { x: ina.left + ina.width / 2, y: ina.top + ina.height / 2 };
      var ntCenter = { x: nt.left + nt.width / 2, y: nt.top + nt.height / 2 };
      var nameScale = nt.height / ina.height;
      introName.style.setProperty("--target-x", (ntCenter.x - inaCenter.x) + "px");
      introName.style.setProperty("--target-y", (ntCenter.y - inaCenter.y) + "px");
      introName.style.setProperty("--target-scale", String(nameScale));
    }

    measure();
    window.addEventListener("resize", measure, { passive: true });

    // Latched-trigger animation: on the first scroll-down input,
    // run --intro-progress 0 → 1 over 700ms. Decouples the
    // animation length from the user's actual scroll distance,
    // so a single wheel click is enough to dismiss the intro.
    var triggered = false;
    function animateOut() {
      if (triggered) return;
      triggered = true;
      var startTs = 0;
      var dur = 700;
      function step(now) {
        if (!startTs) startTs = now;
        var t = (now - startTs) / dur;
        if (t > 1) t = 1;
        // ease-out cubic — fast start, soft landing.
        var eased = 1 - Math.pow(1 - t, 3);
        html.style.setProperty("--intro-progress", String(eased));
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          teardown();
        }
      }
      requestAnimationFrame(step);
    }

    function onScroll() {
      if (window.scrollY > 0) animateOut();
    }
    function onWheel(e) {
      if (e.deltaY > 0) animateOut();
    }
    function onKey(e) {
      var k = e.key;
      if (
        k === "ArrowDown" ||
        k === "PageDown" ||
        k === " " ||
        k === "End" ||
        k === "Enter"
      ) {
        animateOut();
      }
    }
    function onTouch() {
      animateOut();
    }
    function onClick() {
      animateOut();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("wheel", onWheel, { passive: true });
    window.addEventListener("keydown", onKey, { passive: true });
    window.addEventListener("touchmove", onTouch, { passive: true });
    // Click on the cue (or anywhere on the overlay) also triggers.
    overlay.addEventListener("click", onClick);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", __introInit);
  } else {
    __introInit();
  }
</script>
