---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="reveal scroll-mt-24 min-h-[40vh]">
  <h2 class="font-mono font-semibold text-lg md:text-xl uppercase tracking-[0.14em] text-accent mb-10">
    {label}
  </h2>
  <slot />
</section>
