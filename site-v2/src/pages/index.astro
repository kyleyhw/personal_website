---
import { readdirSync, statSync, readFileSync, existsSync } from "node:fs";
import { join, extname, basename } from "node:path";
import yaml from "js-yaml";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Section from "../components/Section.astro";

const asset = (path: string) =>
  (import.meta.env.BASE_URL + "/" + path).replace(/\/+/g, "/");

/* ============================================================
   Climbing scanner — runs at build time.
   Convention: drop media (.mp4/.webm/.mov/.jpg/.jpeg/.png/.webp)
   into public/climbing/. Optionally add a same-basename .md
   sidecar for title / location / date / description. Entries
   sort chronologically by the sidecar `date` field (if set)
   else by media file mtime — newest first.
   ============================================================ */
interface ClimbingEntry {
  basename: string;
  media: string; // path relative to public/, e.g. "/climbing/foo.jpg"
  isVideo: boolean;
  title: string;
  location?: string;
  date?: Date;
  description?: string;
  sortDate: Date; // date || mtime, used for ordering only
}

const VIDEO_EXTS = new Set([".mp4", ".webm", ".mov", ".m4v"]);
const IMAGE_EXTS = new Set([".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif"]);

function loadClimbing(): ClimbingEntry[] {
  const dir = "public/climbing";
  if (!existsSync(dir)) return [];
  const files = readdirSync(dir);
  const entries: ClimbingEntry[] = [];

  for (const filename of files) {
    const ext = extname(filename).toLowerCase();
    const isVideo = VIDEO_EXTS.has(ext);
    const isImage = IMAGE_EXTS.has(ext);
    if (!isVideo && !isImage) continue;

    const base = basename(filename, ext);
    const mediaPath = join(dir, filename);
    const mtime = statSync(mediaPath).mtime;

    // Defaults — basename becomes a readable title when no sidecar exists.
    let fm: Record<string, unknown> = { title: base.replace(/[_-]+/g, " ") };

    const sidecarPath = join(dir, `${base}.md`);
    if (existsSync(sidecarPath)) {
      const raw = readFileSync(sidecarPath, "utf8");
      const match = raw.match(/^---\s*\n([\s\S]*?)\n---/);
      if (match) {
        try {
          const parsed = yaml.load(match[1]) as Record<string, unknown>;
          if (parsed && typeof parsed === "object") fm = { ...fm, ...parsed };
        } catch (err) {
          console.warn(`[climbing] YAML parse failed for ${sidecarPath}:`, err);
        }
      }
    }

    const date = fm.date ? new Date(fm.date as string) : undefined;
    entries.push({
      basename: base,
      media: `/climbing/${filename}`,
      isVideo,
      title: (fm.title as string) ?? base,
      location: fm.location as string | undefined,
      date,
      description: fm.description as string | undefined,
      sortDate: date && !isNaN(date.getTime()) ? date : mtime,
    });
  }

  // Newest first.
  return entries.sort((a, b) => b.sortDate.getTime() - a.sortDate.getTime());
}

const climbing = loadClimbing();

const site = await getEntry("site", "main");
if (!site) throw new Error("site.main not found — check src/content/site.yaml");

const education = (await getCollection("education")).sort(
  (a, b) => (b.data.endDate ?? new Date()).getTime() - (a.data.endDate ?? new Date()).getTime(),
);
const experience = (await getCollection("experience")).sort(
  (a, b) => (b.data.endDate ?? new Date()).getTime() - (a.data.endDate ?? new Date()).getTime(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.priority - a.data.priority,
);

const aboutEntry = await getEntry("about", "main");
const awardsEntry = await getEntry("awards", "main");
const coursesEntry = await getEntry("courses", "main");
const skillsEntry = await getEntry("skills", "main");
const personalEntry = await getEntry("personal", "main");

const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: null };
const { Content: AwardsContent } = awardsEntry ? await render(awardsEntry) : { Content: null };
const { Content: CoursesContent } = coursesEntry ? await render(coursesEntry) : { Content: null };
const { Content: SkillsContent } = skillsEntry ? await render(skillsEntry) : { Content: null };
const { Content: PersonalContent } = personalEntry ? await render(personalEntry) : { Content: null };

const fmtYear = (d?: Date) => (d ? d.getFullYear().toString() : "Present");

// Prose styling shared across singleton-content sections. h2 subheads
// come through as serif medium; lists are bullet-aligned with muted
// body text; strong-text inherits fg so bolded labels pop.
const proseClass = [
  "max-w-2xl text-fg leading-relaxed",
  "[&>p]:mb-5",
  "[&_h2]:font-serif [&_h2]:font-medium [&_h2]:text-2xl [&_h2]:text-fg [&_h2]:mt-12 [&_h2]:mb-4 [&_h2:first-child]:mt-0",
  "[&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ul]:text-fg-muted",
  "[&_strong]:text-fg [&_strong]:font-medium",
].join(" ");
---

<Layout title={`${site.data.name} — ${site.data.tagline}`} description={site.data.tagline}>
  <div
    class="mx-auto max-w-7xl px-6 md:px-12 lg:px-24 lg:grid lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-24"
  >
    <SiteHeader
      name={site.data.name}
      tagline={site.data.tagline}
      email={site.data.socials.email}
      github={site.data.socials.github}
      linkedin={site.data.socials.linkedin}
      cvUrl={site.data.cv_url}
      profileSrc={asset("profile_pic.jpeg")}
    />

    <main class="lg:py-24 space-y-16 pb-24">
      {AboutContent && (
        <Section id="about" label="About">
          <div class={proseClass}><AboutContent /></div>
        </Section>
      )}

      <Section id="education" label="Education">
        <ul class="space-y-10 max-w-2xl">
          {education.map((entry) => (
            <li>
              <div class="flex justify-between items-baseline gap-4 mb-1">
                <h3 class="font-serif font-medium text-xl text-fg">{entry.data.institution}</h3>
                <span class="font-mono text-xs text-fg-subtle whitespace-nowrap">
                  {fmtYear(entry.data.startDate)}–{fmtYear(entry.data.endDate)}
                </span>
              </div>
              <p class="text-fg-muted text-sm mb-1">{entry.data.degree}</p>
              <p class="text-fg-subtle text-xs">{entry.data.location}</p>
              {entry.data.honour && (
                <p class="text-fg-muted text-xs italic mt-2">{entry.data.honour}</p>
              )}
            </li>
          ))}
        </ul>
      </Section>

      <Section id="experience" label="Experience">
        <ul class="space-y-10 max-w-2xl">
          {experience.map(async (entry) => {
            const { Content } = await render(entry);
            return (
              <li>
                <div class="flex justify-between items-baseline gap-4 mb-1">
                  <h3 class="font-serif font-medium text-xl text-fg">{entry.data.role}</h3>
                  <span class="font-mono text-xs text-fg-subtle whitespace-nowrap">
                    {fmtYear(entry.data.startDate)}–{fmtYear(entry.data.endDate)}
                  </span>
                </div>
                <p class="text-fg-muted text-sm mb-1">
                  {entry.data.organization}
                  {entry.data.supervisor && (
                    <span class="text-fg-subtle"> · {entry.data.supervisor}</span>
                  )}
                </p>
                <div class="text-fg-muted text-sm leading-relaxed mt-3 [&_p]:mb-2">
                  <Content />
                </div>
                {entry.data.skills && (
                  <div class="flex flex-wrap gap-1.5 mt-4">
                    {entry.data.skills.map((s) => (
                      <span class="font-mono text-[0.7rem] uppercase tracking-wider text-fg-subtle border border-fg-subtle/40 rounded px-2 py-0.5">
                        {s}
                      </span>
                    ))}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </Section>

      <Section id="projects" label="Projects">
        <ul class="space-y-8 max-w-2xl">
          {projects.map((entry) => (
            <li>
              <a
                href={entry.data.url ?? "#"}
                target={entry.data.url ? "_blank" : undefined}
                rel={entry.data.url ? "noopener noreferrer" : undefined}
                class:list={[
                  "group block border-t border-fg-subtle/30 pt-6 transition-colors duration-200",
                  entry.data.url ? "hover:border-accent/60" : "cursor-default",
                ]}
              >
                <div class="flex justify-between items-baseline gap-4 mb-2">
                  <h3 class:list={[
                    "font-serif font-medium text-xl text-fg transition-colors duration-200",
                    entry.data.url && "group-hover:text-accent",
                  ]}>
                    {entry.data.name}
                  </h3>
                  <span class="font-mono text-xs text-fg-subtle whitespace-nowrap">
                    {entry.data.badge ?? entry.data.language ?? "—"}
                    {entry.data.stars ? ` · ${entry.data.stars}★` : ""}
                  </span>
                </div>
                <p class="text-fg-muted text-sm leading-relaxed">
                  {entry.data.description_override ?? entry.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </Section>

      {AwardsContent && (
        <Section id="awards" label="Awards">
          <div class={proseClass}><AwardsContent /></div>
        </Section>
      )}

      {CoursesContent && (
        <Section id="courses" label="Courses">
          <div class={proseClass}><CoursesContent /></div>
        </Section>
      )}

      {SkillsContent && (
        <Section id="skills" label="Skills">
          <div class={proseClass}><SkillsContent /></div>
        </Section>
      )}

      {PersonalContent && (
        <Section id="personal" label="Personal">
          <div class={proseClass}><PersonalContent /></div>
        </Section>
      )}

      <Section id="climbing" label="Climbing">
        {climbing.length === 0 ? (
          <p class="text-fg-muted text-sm max-w-xl">
            Clips and photos coming soon. Drop media
            (<code class="font-mono text-xs bg-bg-elevated px-1.5 py-0.5 rounded">.mp4</code>,
            <code class="font-mono text-xs bg-bg-elevated px-1.5 py-0.5 rounded">.jpg</code>,
            <code class="font-mono text-xs bg-bg-elevated px-1.5 py-0.5 rounded">.png</code>)
            into <code class="font-mono text-xs bg-bg-elevated px-1.5 py-0.5 rounded">public/climbing/</code>.
            Optionally add a same-basename
            <code class="font-mono text-xs bg-bg-elevated px-1.5 py-0.5 rounded">.md</code>
            sidecar with title / location / date / description.
          </p>
        ) : (
          <ul class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl">
            {climbing.map((entry, i) => (
              <li>
                <button
                  type="button"
                  data-climbing-open={i}
                  aria-label={`Open ${entry.title}`}
                  class="block w-full aspect-[4/3] overflow-hidden rounded border border-fg-subtle/30 bg-bg-elevated
                         transition-[transform,border-color] duration-300 ease-out cursor-pointer
                         motion-safe:hover:scale-[1.03] hover:border-accent/60
                         focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
                >
                  {entry.isVideo ? (
                    <video
                      src={asset(entry.media)}
                      class="w-full h-full object-cover"
                      playsinline
                      muted
                      preload="metadata"
                    />
                  ) : (
                    <img
                      src={asset(entry.media)}
                      alt={entry.title}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  )}
                </button>
              </li>
            ))}
          </ul>
        )}
      </Section>

      {/* Modal dialogs — one per climbing entry. Native <dialog> gives us
          a proper backdrop, Esc handling, and focus trap for free. The
          modal fills ~90% of the viewport; media occupies 2/3 on wide
          screens, details take the remaining 1/3. */}
      {climbing.map((entry, i) => (
        <dialog
          data-climbing-dialog={i}
          aria-label={entry.title}
          class="w-[90vw] h-[90vh] max-w-none max-h-none m-auto p-0 bg-bg-elevated text-fg
                 rounded-lg border border-fg-subtle/30
                 backdrop:bg-black/70 backdrop:backdrop-blur-sm
                 open:opacity-100 opacity-0 transition-opacity duration-300"
        >
          <div class="flex flex-col lg:flex-row h-full">
            <div class="lg:w-2/3 flex-1 bg-black flex items-center justify-center overflow-hidden min-h-0">
              {entry.isVideo ? (
                <video
                  data-climbing-dialog-video={i}
                  src={asset(entry.media)}
                  class="max-w-full max-h-full"
                  playsinline
                  muted
                  loop
                  controls
                  preload="metadata"
                />
              ) : (
                <img
                  src={asset(entry.media)}
                  alt={entry.title}
                  class="max-w-full max-h-full object-contain"
                />
              )}
            </div>
            <aside class="lg:w-1/3 p-8 lg:p-10 overflow-y-auto relative bg-bg-elevated">
              <button
                type="button"
                data-climbing-close
                aria-label="Close"
                class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full
                       text-fg-muted hover:text-fg hover:bg-bg transition-colors cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
                  <path d="M6 6L18 18M6 18L18 6" />
                </svg>
              </button>
              <h3 class="font-serif font-medium text-3xl leading-tight pr-8">
                {entry.title}
              </h3>
              {(entry.location || entry.date) && (
                <p class="font-mono text-xs uppercase tracking-wider text-fg-muted mt-3">
                  {entry.location}
                  {entry.location && entry.date && " · "}
                  {entry.date &&
                    entry.date.toLocaleDateString("en-GB", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    })}
                </p>
              )}
              {entry.description && (
                <p class="text-fg-muted text-base leading-relaxed mt-6 whitespace-pre-line">
                  {entry.description}
                </p>
              )}
            </aside>
          </div>
        </dialog>
      ))}

      <footer class="pt-12 font-mono text-xs text-fg-subtle">
        Built with Astro. Content is Markdown under
        <code class="text-fg-muted">src/content/</code>.
      </footer>
    </main>
  </div>

  {/* Climbing modal: open <dialog> on card click; backdrop click / Esc
      closes. Videos auto-play on open and reset on close so users only
      see motion when the modal is active. */}
  <script is:inline>
    (function () {
      var openers = document.querySelectorAll("[data-climbing-open]");
      var dialogs = document.querySelectorAll("[data-climbing-dialog]");

      function dialogForIndex(idx) {
        return document.querySelector(
          '[data-climbing-dialog="' + idx + '"]',
        );
      }

      function openModal(idx) {
        var dlg = dialogForIndex(idx);
        if (!dlg) return;
        // <dialog> supports showModal() on modern browsers.
        if (typeof dlg.showModal === "function") dlg.showModal();
        else dlg.setAttribute("open", "");
        var video = dlg.querySelector("video");
        if (video) {
          video.currentTime = 0;
          var p = video.play();
          if (p && typeof p.catch === "function") p.catch(function () {});
        }
      }

      function closeModal(dlg) {
        if (typeof dlg.close === "function") dlg.close();
        else dlg.removeAttribute("open");
        var video = dlg.querySelector("video");
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
      }

      openers.forEach(function (btn) {
        btn.addEventListener("click", function () {
          openModal(btn.getAttribute("data-climbing-open"));
        });
      });

      dialogs.forEach(function (dlg) {
        // Click on the backdrop (target is the dialog itself, not its children)
        // closes the modal.
        dlg.addEventListener("click", function (e) {
          if (e.target === dlg) closeModal(dlg);
        });
        // Close buttons inside the dialog.
        var closers = dlg.querySelectorAll("[data-climbing-close]");
        closers.forEach(function (c) {
          c.addEventListener("click", function () {
            closeModal(dlg);
          });
        });
        // Pause video when the dialog is closed via Esc (handled by <dialog>
        // natively; we catch the 'close' event to sync video state).
        dlg.addEventListener("close", function () {
          var video = dlg.querySelector("video");
          if (video) {
            video.pause();
            video.currentTime = 0;
          }
        });
      });
    })();
  </script>
</Layout>
